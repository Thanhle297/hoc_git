@model CategoriesPageViewModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="categories-page">
    <!-- Hero Section -->
    <section class="categories-hero">
        <div class="container">
            <div class="hero-content">
                <span class="hero-badge">
                    <svg class="badge-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M7 7h.01M7 3h5c.512 0 1.024.195 1.414.586l7 7a2 2 0 010 2.828l-7 7a2 2 0 01-2.828 0l-7-7A1.994 1.994 0 013 12V7a4 4 0 014-4z" />
                    </svg>
                    Khám phá theo nhóm
                </span>
                <h1 class="hero-title">@Model.Title</h1>
                <p class="hero-description">@Model.Description</p>
            </div>
        </div>
    </section>

    <!-- Categories Grid -->
    <section class="categories-section">
        <div class="container">
            <div class="categories-grid">
                @foreach (var category in Model.Categories)
                {
                    <article class="category-card-modern" data-category="@category.FilterValue">
                        <a asp-controller="Products" asp-action="Search" asp-route-q="@category.FilterValue" class="category-link">
                            <div class="category-image-wrapper">
                                <img src="@category.ImageUrl" alt="@category.Name" class="category-image" loading="lazy" />
                                <div class="category-overlay"></div>
                                <div class="category-badge-count">
                                    <svg class="count-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4" />
                                    </svg>
                                    <span>@category.ProductCount</span>
                                </div>
                            </div>

                            <div class="category-content">
                                <div class="category-header">
                                    <h3 class="category-name">@category.Name</h3>
                                    <svg class="category-arrow" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3" />
                                    </svg>
                                </div>
                                <p class="category-description">@category.Description</p>

                                <div class="category-footer">
                                    <span class="category-cta">
                                        Khám phá ngay
                                        <svg class="cta-icon" xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7" />
                                        </svg>
                                    </span>
                                </div>
                            </div>
                        </a>
                    </article>
                }
            </div>
        </div>
    </section>

    <!-- Features Section -->
    <section class="categories-features">
        <div class="container">
            <div class="features-grid">
                <div class="feature-item">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 3v4M3 5h4M6 17v4m-2-2h4m5-16l2.286 6.857L21 12l-5.714 2.143L13 21l-2.286-6.857L5 12l5.714-2.143L13 3z" />
                        </svg>
                    </div>
                    <h4 class="feature-title">Chất lượng cao</h4>
                    <p class="feature-text">Sản phẩm được tuyển chọn kỹ lưỡng</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h4 class="feature-title">Giao hàng nhanh</h4>
                    <p class="feature-text">Miễn phí vận chuyển cho đơn từ 500k</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                        </svg>
                    </div>
                    <h4 class="feature-title">Đổi trả dễ dàng</h4>
                    <p class="feature-text">Chính sách đổi trả trong 30 ngày</p>
                </div>

                <div class="feature-item">
                    <div class="feature-icon">
                        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3 .895 3 2-1.343 2-3 2m0-8c1.11 0 2.08.402 2.599 1M12 8V7m0 1v8m0 0v1m0-1c-1.11 0-2.08-.402-2.599-1M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                        </svg>
                    </div>
                    <h4 class="feature-title">Giá tốt nhất</h4>
                    <p class="feature-text">Cam kết giá cạnh tranh nhất thị trường</p>
                </div>
            </div>
        </div>
    </section>
</div>
