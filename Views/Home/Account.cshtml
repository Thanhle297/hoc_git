@model AccountProfileViewModel

@{
    ViewData["Title"] = "Tài khoản của tôi";
}

<div class="space-y-6">
    <section class="overflow-hidden rounded-[2rem] border border-indigo-100 bg-white shadow-sm">
        <div class="bg-gradient-to-r from-indigo-600 via-violet-600 to-purple-600 px-6 py-8 text-white sm:px-8">
            <div class="flex flex-col gap-5 sm:flex-row sm:items-center sm:justify-between">
                <div class="flex items-center gap-4">
                    <div class="flex h-16 w-16 items-center justify-center rounded-2xl bg-white/15 text-2xl font-bold ring-1 ring-white/30 backdrop-blur">
                        @Model.FullName.Trim()[0].ToString().ToUpperInvariant()
                    </div>
                    <div>
                        <p class="text-sm font-medium text-indigo-100">Xin chào,</p>
                        <h2 class="mt-1 text-2xl font-bold sm:text-3xl">@Model.FullName</h2>
                        <span class="mt-3 inline-flex rounded-full bg-white px-3 py-1 text-sm font-bold text-indigo-600">@Model.RoleDisplayName</span>
                    </div>
                </div>
                <form asp-controller="Home" asp-action="Logout" method="post">
                    <button type="submit" class="rounded-full bg-white/15 px-5 py-2.5 text-sm font-bold text-white ring-1 ring-white/30 transition hover:bg-white hover:text-indigo-600">
                        Đăng xuất
                    </button>
                </form>
            </div>
        </div>

        <div class="grid gap-4 p-6 sm:grid-cols-2 lg:grid-cols-4 lg:p-8">
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-sm font-semibold text-slate-500">Email</p>
                <p class="mt-2 break-all font-bold text-slate-900">@Model.Email</p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-sm font-semibold text-slate-500">Số điện thoại</p>
                <p class="mt-2 font-bold text-slate-900">@(Model.PhoneNumber ?? "Chưa cập nhật")</p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-sm font-semibold text-slate-500">Ngày tạo</p>
                <p class="mt-2 font-bold text-slate-900">@Model.CreatedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</p>
            </div>
            <div class="rounded-2xl border border-slate-200 bg-slate-50 p-4">
                <p class="text-sm font-semibold text-slate-500">Lần đăng nhập gần nhất</p>
                <p class="mt-2 font-bold text-slate-900">@(Model.LastLoginAt?.ToLocalTime().ToString("dd/MM/yyyy HH:mm") ?? "Chưa có")</p>
            </div>
        </div>
    </section>

    <section class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="flex flex-col gap-2 border-b border-slate-100 pb-5">
            <p class="text-sm font-semibold uppercase tracking-[0.2em] text-indigo-600">Thông tin tài khoản</p>
            <h2 class="text-2xl font-bold text-slate-900">Hồ sơ cá nhân</h2>
            <p class="text-sm text-slate-500">Thông tin được lấy từ tài khoản đã đăng ký trong cơ sở dữ liệu local.</p>
        </div>

        <dl class="mt-6 grid gap-4 sm:grid-cols-2">
            <div class="rounded-2xl border border-slate-200 p-4">
                <dt class="text-sm font-semibold text-slate-500">Họ</dt>
                <dd class="mt-1 text-lg font-bold text-slate-900">@Model.FirstName</dd>
            </div>
            <div class="rounded-2xl border border-slate-200 p-4">
                <dt class="text-sm font-semibold text-slate-500">Tên</dt>
                <dd class="mt-1 text-lg font-bold text-slate-900">@Model.LastName</dd>
            </div>
            <div class="rounded-2xl border border-slate-200 p-4">
                <dt class="text-sm font-semibold text-slate-500">Vai trò hệ thống</dt>
                <dd class="mt-1 text-lg font-bold text-slate-900">@Model.RoleDisplayName</dd>
            </div>
            <div class="rounded-2xl border border-slate-200 p-4">
                <dt class="text-sm font-semibold text-slate-500">Mã vai trò</dt>
                <dd class="mt-1 text-lg font-bold text-slate-900">@Model.Role</dd>
            </div>
        </dl>
    </section>
</div>
