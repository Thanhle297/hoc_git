        @if (User.Identity?.IsAuthenticated == true)
        {
            <a asp-controller="Home" asp-action="Account" class="block rounded-xl bg-indigo-600 px-4 py-3 text-center text-white hover:bg-indigo-700 transition">Tài khoản của tôi</a>
            <form asp-controller="Home" asp-action="Logout" method="post">
                <button type="submit" class="block w-full rounded-xl border border-red-200 px-4 py-3 text-center font-semibold text-red-600 hover:bg-red-50 transition">Đăng xuất</button>
            </form>
        }
        else
        {
            <a asp-controller="Home" asp-action="Login" class="block rounded-xl bg-indigo-600 px-4 py-3 text-center text-white hover:bg-indigo-700 transition">Đăng nhập</a>
        }
    </nav>
</aside>

<button class="scroll-to-top" aria-label="Lên đầu trang">↑</button>
