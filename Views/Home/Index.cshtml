@{
    ViewData["Title"] = "Trang chủ";
}

<!-- Top Bar -->
<div class="bg-gradient-to-r from-indigo-600 to-purple-600 text-white py-2">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between text-sm">
            <div class="flex items-center gap-6">
                <span class="hidden sm:inline">📞 Hotline: 1900-xxxx</span>
                <span class="hidden md:inline">📧 support@fashionstore.vn</span>
            </div>
            <div class="flex items-center gap-4">
                <a asp-controller="Products" asp-action="Index" class="hover:text-indigo-200 transition">Xem sản phẩm</a>
                <span class="hidden sm:inline">|</span>
                <a asp-controller="Home" asp-action="Privacy" class="hover:text-indigo-200 transition hidden sm:inline">Chính sách</a>
            </div>
        </div>
    </div>
</div>

<!-- Main Header -->
<header class="bg-white shadow-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex items-center justify-between h-20">
            <!-- Logo -->
            <div class="flex items-center">
                <a asp-controller="Home" asp-action="Index" class="flex items-center gap-3">
                    <div class="w-12 h-12 bg-gradient-to-br from-indigo-600 to-purple-600 rounded-xl flex items-center justify-center">
                        <span class="text-white font-bold text-xl">FS</span>
                    </div>
                    <div class="hidden sm:block">
                        <h1 class="text-2xl font-bold gradient-text">Fashion Store</h1>
                        <p class="text-xs text-gray-500">Thời trang & Phong cách</p>
                    </div>
                </a>
            </div>

            <!-- Search Bar (Desktop) -->
            <div class="hidden lg:flex flex-1 max-w-2xl mx-8">
                <form asp-controller="Products" asp-action="Search" method="get" class="relative w-full">
                    <input type="text"
                           name="q"
                           placeholder="Tìm kiếm sản phẩm, thương hiệu..."
                           class="w-full px-6 py-3 pr-12 rounded-full border-2 border-gray-200 focus:border-indigo-500 focus:outline-none transition">
                    <button type="submit" class="absolute right-2 top-1/2 -translate-y-1/2 bg-indigo-600 text-white w-10 h-10 rounded-full hover:bg-indigo-700 transition flex items-center justify-center">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
                        </svg>
                    </button>
                </form>
            </div>

            <!-- Actions -->
            <div class="flex items-center gap-4">
                <a href="#" class="relative p-2 hover:bg-gray-100 rounded-lg transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                    <span class="absolute -top-1 -right-1 bg-red-500 text-white text-xs w-5 h-5 rounded-full flex items-center justify-center">3</span>
                </a>

                <a href="#" class="relative p-2 hover:bg-gray-100 rounded-lg transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 3h2l.4 2M7 13h10l4-8H5.4M7 13L5.4 5M7 13l-2.293 2.293c-.63.63-.184 1.707.707 1.707H17m0 0a2 2 0 100 4 2 2 0 000-4zm-8 2a2 2 0 11-4 0 2 2 0 014 0z"></path>
                    </svg>
                    <span class="absolute -top-1 -right-1 bg-indigo-600 text-white text-xs w-5 h-5 rounded-full flex items-center justify-center">5</span>
                </a>

                @if (User.Identity?.IsAuthenticated == true)
                {
                    <partial name="_AccountMenu" />
                }
                else
                {
                    <a asp-controller="Home" asp-action="Login" class="hidden md:flex items-center gap-2 px-4 py-2 rounded-lg hover:bg-gray-100 transition">
                        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                        </svg>
                        <span class="text-sm font-medium">Đăng nhập</span>
                    </a>
                }

                <button data-mobile-menu-btn class="lg:hidden p-2 hover:bg-gray-100 rounded-lg transition">
                    <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                </button>
            </div>
        </div>

        <!-- Navigation (Desktop) -->
        <nav class="hidden lg:flex items-center gap-8 py-4 border-t border-gray-100">
            <div class="relative" data-mega-menu-trigger>
                <button class="flex items-center gap-2 font-medium hover:text-indigo-600 transition">
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
                    </svg>
                    Danh mục sản phẩm
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"></path>
                    </svg>
                </button>
            </div>
            <a asp-controller="Products" asp-action="Index" asp-route-sort="Bán chạy" class="font-medium hover:text-indigo-600 transition">🔥 Flash Sale</a>
            <a asp-controller="Products" asp-action="Search" asp-route-q="Nam" class="font-medium hover:text-indigo-600 transition">Thời trang Nam</a>
            <a asp-controller="Products" asp-action="Search" asp-route-q="Nữ" class="font-medium hover:text-indigo-600 transition">Thời trang Nữ</a>
            <a asp-controller="Categories" asp-action="Index" class="font-medium hover:text-indigo-600 transition">Giày dép</a>
            <a asp-controller="Products" asp-action="Search" asp-route-q="Phụ kiện" class="font-medium hover:text-indigo-600 transition">Phụ kiện</a>
            <a href="#" class="text-red-600 font-semibold hover:text-red-700 transition">🎁 Khuyến mãi</a>
        </nav>
    </div>

    <!-- Mega Menu -->
    <div class="mega-menu">
        <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
            <div class="grid grid-cols-4 gap-8">
                <div>
                    <h3 class="font-bold text-lg mb-4 text-indigo-600">Thời trang Nam</h3>
                    <ul class="space-y-2 text-sm">
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Nam" class="hover:text-indigo-600 transition">Áo thun</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Nam" class="hover:text-indigo-600 transition">Áo sơ mi</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Nam" class="hover:text-indigo-600 transition">Quần jean</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Nam" class="hover:text-indigo-600 transition">Quần kaki</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="áo khoác" class="hover:text-indigo-600 transition">Áo khoác</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-4 text-indigo-600">Thời trang Nữ</h3>
                    <ul class="space-y-2 text-sm">
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Nữ" class="hover:text-indigo-600 transition">Váy đầm</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Nữ" class="hover:text-indigo-600 transition">Áo kiểu</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Nữ" class="hover:text-indigo-600 transition">Quần jean nữ</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Nữ" class="hover:text-indigo-600 transition">Chân váy</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Nữ" class="hover:text-indigo-600 transition">Áo len</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-4 text-indigo-600">Giày dép</h3>
                    <ul class="space-y-2 text-sm">
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Giày" class="hover:text-indigo-600 transition">Giày thể thao</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Giày" class="hover:text-indigo-600 transition">Giày tây</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Giày" class="hover:text-indigo-600 transition">Giày cao gót</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Giày" class="hover:text-indigo-600 transition">Dép sandal</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Giày" class="hover:text-indigo-600 transition">Boot</a></li>
                    </ul>
                </div>
                <div>
                    <h3 class="font-bold text-lg mb-4 text-indigo-600">Phụ kiện</h3>
                    <ul class="space-y-2 text-sm">
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Phụ kiện" class="hover:text-indigo-600 transition">Túi xách</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Phụ kiện" class="hover:text-indigo-600 transition">Ví da</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Phụ kiện" class="hover:text-indigo-600 transition">Thắt lưng</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Phụ kiện" class="hover:text-indigo-600 transition">Mũ nón</a></li>
                        <li><a asp-controller="Products" asp-action="Search" asp-route-q="Phụ kiện" class="hover:text-indigo-600 transition">Kính mát</a></li>
                    </ul>
                </div>
            </div>
        </div>
    </div>
</header>

<!-- Hero Carousel -->
<section class="hero-carousel relative bg-gray-900">
    <!-- Slide 1 -->
    <div class="carousel-item active">
        <div class="relative h-[500px] md:h-[600px]">
            <img src="https://images.unsplash.com/photo-1441984904996-e0b6ba687e04?auto=format&fit=crop&w=1920&q=80" 
                 alt="Fashion Collection" 
                 class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-r from-black/70 to-transparent"></div>
            <div class="absolute inset-0 flex items-center">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
                    <div class="max-w-2xl text-white" data-animate>
                        <h2 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
                            Bộ sưu tập<br/>Thời trang 2026
                        </h2>
                        <p class="text-xl mb-8 text-gray-200">
                            Khám phá xu hướng mới nhất với hàng ngàn sản phẩm độc đáo
                        </p>
                        <div class="flex gap-4">
                            <a asp-controller="Products" asp-action="Index" class="bg-white text-gray-900 px-8 py-4 rounded-full font-semibold hover:bg-gray-100 transition transform hover:scale-105">
                                Khám phá ngay
                            </a>
                            <a asp-controller="Categories" asp-action="Index" class="border-2 border-white px-8 py-4 rounded-full font-semibold hover:bg-white hover:text-gray-900 transition">
                                Xem bộ sưu tập
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 2 -->
    <div class="carousel-item">
        <div class="relative h-[500px] md:h-[600px]">
            <img src="https://images.unsplash.com/photo-1445205170230-053b83016050?auto=format&fit=crop&w=1920&q=80" 
                 alt="Shoes Collection" 
                 class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-r from-indigo-900/80 to-transparent"></div>
            <div class="absolute inset-0 flex items-center">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
                    <div class="max-w-2xl text-white">
                        <h2 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
                            Giày dép<br/>Phong cách
                        </h2>
                        <p class="text-xl mb-8 text-indigo-100">
                            Từ thể thao đến công sở - Tìm đôi giày hoàn hảo cho bạn
                        </p>
                        <div class="flex gap-4">
                            <a asp-controller="Products" asp-action="Search" asp-route-q="Giày" class="bg-white text-indigo-600 px-8 py-4 rounded-full font-semibold hover:bg-gray-100 transition transform hover:scale-105">
                                Mua ngay
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Slide 3 -->
    <div class="carousel-item">
        <div class="relative h-[500px] md:h-[600px]">
            <img src="https://images.unsplash.com/photo-1490481651871-ab68de25d43d?auto=format&fit=crop&w=1920&q=80" 
                 alt="Accessories" 
                 class="w-full h-full object-cover">
            <div class="absolute inset-0 bg-gradient-to-r from-purple-900/80 to-transparent"></div>
            <div class="absolute inset-0 flex items-center">
                <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full">
                    <div class="max-w-2xl text-white">
                        <h2 class="text-5xl md:text-6xl font-bold mb-6 leading-tight">
                            Phụ kiện<br/>Hoàn hảo
                        </h2>
                        <p class="text-xl mb-8 text-purple-100">
                            Hoàn thiện phong cách của bạn với các phụ kiện thời thượng
                        </p>
                        <div class="flex gap-4">
                            <a asp-controller="Products" asp-action="Search" asp-route-q="Phụ kiện" class="bg-white text-purple-600 px-8 py-4 rounded-full font-semibold hover:bg-gray-100 transition transform hover:scale-105">
                                Xem ngay
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Carousel Indicators -->
    <div class="carousel-indicators">
        <button class="carousel-indicator active"></button>
        <button class="carousel-indicator"></button>
        <button class="carousel-indicator"></button>
    </div>
</section>

<!-- Categories Section -->
<section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
    <div class="text-center mb-12" data-animate>
        <h2 class="text-4xl font-bold mb-4">Danh mục sản phẩm</h2>
        <p class="text-gray-600 text-lg">Khám phá các danh mục thời trang phong phú</p>
    </div>

    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 md:gap-6">
        <div class="category-card group" data-animate>
            <div class="relative h-64 md:h-80 overflow-hidden rounded-2xl">
                <img src="https://images.unsplash.com/photo-1620799140408-edc6dcb6d633?auto=format&fit=crop&w=800&q=80" 
                     alt="Thời trang Nam" 
                     class="w-full h-full object-cover">
                <div class="category-card-content">
                    <h3 class="text-2xl font-bold mb-2">Thời trang Nam</h3>
                    <p class="text-sm text-gray-200 mb-3">Hơn 500+ sản phẩm</p>
                    <a asp-controller="Products" asp-action="Search" asp-route-q="Nam" class="inline-block bg-white text-gray-900 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-gray-100 transition">
                        Xem ngay
                    </a>
                </div>
            </div>
        </div>

        <div class="category-card group" data-animate>
            <div class="relative h-64 md:h-80 overflow-hidden rounded-2xl">
                <img src="https://images.unsplash.com/photo-1483985988355-763728e1935b?auto=format&fit=crop&w=800&q=80" 
                     alt="Thời trang Nữ" 
                     class="w-full h-full object-cover">
                <div class="category-card-content">
                    <h3 class="text-2xl font-bold mb-2">Thời trang Nữ</h3>
                    <p class="text-sm text-gray-200 mb-3">Hơn 800+ sản phẩm</p>
                    <a asp-controller="Products" asp-action="Search" asp-route-q="Nữ" class="inline-block bg-white text-gray-900 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-gray-100 transition">
                        Xem ngay
                    </a>
                </div>
            </div>
        </div>

        <div class="category-card group" data-animate>
            <div class="relative h-64 md:h-80 overflow-hidden rounded-2xl">
                <img src="https://images.unsplash.com/photo-1549298916-b41d501d3772?auto=format&fit=crop&w=800&q=80" 
                     alt="Giày dép" 
                     class="w-full h-full object-cover">
                <div class="category-card-content">
                    <h3 class="text-2xl font-bold mb-2">Giày dép</h3>
                    <p class="text-sm text-gray-200 mb-3">Hơn 300+ sản phẩm</p>
                    <a asp-controller="Products" asp-action="Search" asp-route-q="Giày" class="inline-block bg-white text-gray-900 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-gray-100 transition">
                        Xem ngay
                    </a>
                </div>
            </div>
        </div>

        <div class="category-card group" data-animate>
            <div class="relative h-64 md:h-80 overflow-hidden rounded-2xl">
                <img src="https://images.unsplash.com/photo-1590874103328-eac38a683ce7?auto=format&fit=crop&w=800&q=80" 
                     alt="Phụ kiện" 
                     class="w-full h-full object-cover">
                <div class="category-card-content">
                    <h3 class="text-2xl font-bold mb-2">Phụ kiện</h3>
                    <p class="text-sm text-gray-200 mb-3">Hơn 200+ sản phẩm</p>
                    <a asp-controller="Products" asp-action="Search" asp-route-q="Phụ kiện" class="inline-block bg-white text-gray-900 px-4 py-2 rounded-lg text-sm font-semibold hover:bg-gray-100 transition">
                        Xem ngay
                    </a>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Flash Sale Section -->
<section class="bg-gradient-to-r from-red-600 to-pink-600 py-16">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex flex-col md:flex-row items-center justify-between mb-8 gap-6">
            <div class="text-white text-center md:text-left">
                <h2 class="text-4xl font-bold mb-2 flex items-center justify-center md:justify-start gap-3">
                    <span>🔥</span> Flash Sale
                </h2>
                <p class="text-red-100">Giảm giá sốc - Số lượng có hạn</p>
            </div>
            
            <div class="flex gap-3" data-countdown="2026-05-11T23:59:59">
                <div class="timer-box">
                    <span class="number" data-hours>12</span>
                    <span class="label">Giờ</span>
                </div>
                <div class="timer-box">
                    <span class="number" data-minutes>34</span>
                    <span class="label">Phút</span>
                </div>
                <div class="timer-box">
                    <span class="number" data-seconds>56</span>
                    <span class="label">Giây</span>
                </div>
            </div>
        </div>

        <div class="grid grid-cols-2 md:grid-cols-4 lg:grid-cols-5 gap-4 md:gap-6">
