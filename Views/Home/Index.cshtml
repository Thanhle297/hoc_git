                    <span class="product-badge">-50%</span>
                </div>
                <div class="p-4">
                    <h3 class="font-semibold text-lg mb-1 line-clamp-1">Giày thể thao Nike</h3>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-red-600 font-bold text-xl">599.000đ</span>
                        <span class="text-gray-400 line-through text-sm">1.200.000đ</span>
                    </div>
                    <div class="mb-3">
                        <div class="flex justify-between text-xs mb-1">
                            <span class="text-gray-600">Đã bán 45/100</span>
                            <span class="text-red-600 font-semibold">45%</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-red-600 h-2 rounded-full" style="width: 45%"></div>
                        </div>
                    </div>
                    <button data-add-to-cart class="w-full bg-red-600 text-white py-2 rounded-lg hover:bg-red-700 transition font-semibold">
                        Mua ngay
                    </button>
                </div>
            </div>

            <div class="product-card bg-white rounded-2xl overflow-hidden" data-animate>
                <div class="relative">
                    <img src="https://images.unsplash.com/photo-1512436991641-6745cdb1723f?auto=format&fit=crop&w=800&q=80" 
                         alt="Áo thun" 
                         class="w-full h-48 object-cover">
                    <span class="product-badge">-40%</span>
                </div>
                <div class="p-4">
                    <h3 class="font-semibold text-lg mb-1 line-clamp-1">Áo thun Premium</h3>
                    <div class="flex items-center gap-2 mb-3">
                        <span class="text-red-600 font-bold text-xl">270.000đ</span>
                        <span class="text-gray-400 line-through text-sm">450.000đ</span>
                    </div>
                    <div class="mb-3">
                        <div class="flex justify-between text-xs mb-1">
                            <span class="text-gray-600">Đã bán 68/100</span>
                            <span class="text-red-600 font-semibold">68%</span>
                        </div>
                        <div class="w-full bg-gray-200 rounded-full h-2">
                            <div class="bg-red-600 h-2 rounded-full" style="width: 68%"></div>
                        </div>
                    </div>
                    <button data-add-to-cart class="w-full bg-red-600 text-white py-2 rounded-lg hover:bg-red-700 transition font-semibold">
                        Mua ngay
                    </button>
                </div>
            </div>

