@{
    ViewData["Title"] = "Đăng nhập";
}

<section class="site-auth-section">
    <div class="mx-auto w-full max-w-5xl overflow-hidden rounded-3xl bg-white shadow-2xl ring-1 ring-slate-200 lg:grid lg:grid-cols-2">
        <div class="hidden lg:flex flex-col justify-between bg-gradient-to-br from-indigo-600 to-blue-500 p-10 text-white">
            <div>
                <a asp-controller="Home" asp-action="Index" class="site-back-link inline-flex items-center gap-2 text-sm font-semibold text-indigo-100 hover:text-white">
                    <span aria-hidden="true">&#8592;</span>
                    Quay về trang chủ
                </a>
                <h1 class="mt-8 text-4xl font-bold leading-tight">Chào mừng bạn quay trở lại</h1>
                <p class="mt-4 text-indigo-100">
                    Đăng nhập để theo dõi đơn hàng, lưu sản phẩm yêu thích và nhận ưu đãi riêng dành cho thành viên.
                </p>
            </div>
            <div class="rounded-2xl bg-white/15 p-5 backdrop-blur-sm">
                <p class="text-sm text-indigo-100">Tài khoản demo</p>
                <p class="mt-1 font-semibold">Email: demo@datnshop.com</p>
                <p class="font-semibold">Mật khẩu: 123456</p>
            </div>
        </div>

        <div class="p-6 sm:p-10 lg:p-12">
            <div class="mx-auto w-full max-w-md">
                <a asp-controller="Home" asp-action="Index" class="site-back-link mb-6 inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 hover:text-indigo-700 lg:hidden">
                    <span aria-hidden="true">&#8592;</span>
                    Về trang chủ
                </a>

                <span class="site-kicker">Khu vực thành viên</span>
                <h2 class="mt-4 text-3xl font-bold text-slate-900">Đăng nhập</h2>
                <p class="mt-2 text-sm text-slate-500">Nhập thông tin tài khoản của bạn để tiếp tục.</p>

                <form class="mt-8 space-y-5" method="post" action="#">
                    <div>
                        <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">Email</label>
                        <input
                            id="email"
                            name="email"
                            type="email"
                            required
                            autocomplete="email"
                            placeholder="ban@example.com"
                            class="site-input" />
                    </div>

                    <div>
                        <div class="mb-2 flex items-center justify-between">
                            <label for="password" class="block text-sm font-semibold text-slate-700">Mật khẩu</label>
                            <a href="#" class="text-xs font-semibold text-indigo-600 hover:text-indigo-700">Quên mật khẩu?</a>
                        </div>
                        <input
                            id="password"
                            name="password"
                            type="password"
                            required
                            autocomplete="current-password"
                            placeholder="Nhập mật khẩu"
                            class="site-input" />
                    </div>

                    <div class="flex items-center justify-between text-sm">
                        <label class="inline-flex items-center gap-2 text-slate-600">
                            <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                            Ghi nhớ đăng nhập
                        </label>
                    </div>

                    <button type="submit" class="site-button-primary w-full justify-center">
                        Đăng nhập
                    </button>
                </form>

                <p class="mt-6 text-center text-sm text-slate-500">
                    Chưa có tài khoản?
                    <a href="#" class="site-inline-link font-semibold">Đăng ký ngay</a>
                </p>
            </div>
        </div>
    </div>
</section>
