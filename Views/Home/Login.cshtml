@{
    ViewData["Title"] = "Dang nhap";
}

<section class="min-h-screen bg-gradient-to-br from-slate-100 via-white to-indigo-100 py-10 px-4 sm:px-6 lg:px-8">
    <div class="mx-auto w-full max-w-5xl overflow-hidden rounded-3xl bg-white shadow-2xl ring-1 ring-slate-200 lg:grid lg:grid-cols-2">
        <div class="hidden lg:flex flex-col justify-between bg-gradient-to-br from-indigo-600 to-blue-500 p-10 text-white">
            <div>
                <a asp-controller="Home" asp-action="Index" class="inline-flex items-center gap-2 text-sm font-semibold text-indigo-100 hover:text-white">
                    <span aria-hidden="true">&#8592;</span>
                    Quay ve trang chu
                </a>
                <h1 class="mt-8 text-4xl font-bold leading-tight">Chao mung ban quay tro lai</h1>
                <p class="mt-4 text-indigo-100">
                    Dang nhap de theo doi don hang, luu san pham yeu thich va nhan uu dai rieng danh cho thanh vien.
                </p>
            </div>
            <div class="rounded-2xl bg-white/15 p-5 backdrop-blur-sm">
                <p class="text-sm text-indigo-100">Tai khoan demo</p>
                <p class="mt-1 font-semibold">Email: demo@datnshop.com</p>
                <p class="font-semibold">Mat khau: 123456</p>
            </div>
        </div>

        <div class="p-6 sm:p-10 lg:p-12">
            <div class="mx-auto w-full max-w-md">
                <a asp-controller="Home" asp-action="Index" class="mb-6 inline-flex items-center gap-2 text-sm font-semibold text-indigo-600 hover:text-indigo-700 lg:hidden">
                    <span aria-hidden="true">&#8592;</span>
                    Ve trang chu
                </a>

                <h2 class="text-3xl font-bold text-slate-900">Dang nhap</h2>
                <p class="mt-2 text-sm text-slate-500">Nhap thong tin tai khoan cua ban de tiep tuc.</p>

                <form class="mt-8 space-y-5" method="post" action="#">
                    <div>
                        <label for="email" class="mb-2 block text-sm font-semibold text-slate-700">Email</label>
                        <input
                            id="email"
                            name="email"
                            type="email"
                            required
                            autocomplete="email"
                            placeholder="ban@example.com"
                            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" />
                    </div>

                    <div>
                        <div class="mb-2 flex items-center justify-between">
                            <label for="password" class="block text-sm font-semibold text-slate-700">Mat khau</label>
                            <a href="#" class="text-xs font-semibold text-indigo-600 hover:text-indigo-700">Quen mat khau?</a>
                        </div>
                        <input
                            id="password"
                            name="password"
                            type="password"
                            required
                            autocomplete="current-password"
                            placeholder="Nhap mat khau"
                            class="w-full rounded-xl border border-slate-300 px-4 py-3 text-sm outline-none transition focus:border-indigo-500 focus:ring-2 focus:ring-indigo-200" />
                    </div>

                    <div class="flex items-center justify-between text-sm">
                        <label class="inline-flex items-center gap-2 text-slate-600">
                            <input type="checkbox" class="h-4 w-4 rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                            Ghi nho dang nhap
                        </label>
                    </div>

                    <button type="submit" class="w-full rounded-xl bg-indigo-600 px-4 py-3 text-sm font-semibold text-white transition hover:bg-indigo-700">
                        Dang nhap
                    </button>
                </form>

                <p class="mt-6 text-center text-sm text-slate-500">
                    Chua co tai khoan?
                    <a href="#" class="font-semibold text-indigo-600 hover:text-indigo-700">Dang ky ngay</a>
                </p>
            </div>
        </div>
    </div>
</section>
