@model ProductDetailPageViewModel
@{
    ViewData["Title"] = Model.Product.Name;
}

<section class="space-y-8">
    <div class="grid gap-8 lg:grid-cols-[1.1fr_0.9fr]">
        <div class="space-y-4">
            <div class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
                <img src="@Model.Product.GalleryImages.FirstOrDefault()" alt="@Model.Product.Name" class="h-[28rem] w-full object-cover" />
            </div>

            <div class="grid grid-cols-3 gap-4">
                @foreach (var image in Model.Product.GalleryImages)
                {
                    <div class="overflow-hidden rounded-2xl border border-slate-200 bg-white">
                        <img src="@image" alt="@Model.Product.Name" class="h-28 w-full object-cover" />
                    </div>
                }
            </div>
        </div>

        <div class="space-y-6 rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
            <div class="flex flex-wrap items-center gap-3 text-sm">
                <span class="rounded-full bg-indigo-50 px-4 py-2 font-semibold text-indigo-600">@Model.Product.Gender</span>
                <span class="rounded-full bg-slate-100 px-4 py-2 font-semibold text-slate-600">@Model.Product.Category</span>
                <span class="rounded-full bg-emerald-50 px-4 py-2 font-semibold text-emerald-600">@Model.Product.StockLabel</span>
            </div>

            <div>
                <h2 class="text-3xl font-bold text-slate-900">@Model.Product.Name</h2>
                <p class="mt-3 text-base leading-7 text-slate-600">@Model.Product.Description</p>
            </div>

            <div class="flex items-end gap-4">
                <p class="text-3xl font-bold text-slate-900">@Model.Product.Price.ToString("N0")đ</p>
                @if (Model.Product.OriginalPrice.HasValue)
                {
                    <p class="pb-1 text-base text-slate-400 line-through">@Model.Product.OriginalPrice.Value.ToString("N0")đ</p>
                }
            </div>

            <div class="space-y-3">
                <p class="text-sm font-semibold text-slate-900">Chọn size</p>
                <div class="flex flex-wrap gap-3">
                    @foreach (var size in Model.Product.Sizes)
                    {
                        <button type="button" class="inline-flex h-11 min-w-11 items-center justify-center rounded-xl border border-slate-200 px-4 text-sm font-medium text-slate-700 transition hover:border-indigo-300 hover:text-indigo-600">
                            @size
                        </button>
                    }
                </div>
            </div>

            <div class="space-y-3">
                <p class="text-sm font-semibold text-slate-900">Chọn màu</p>
                <div class="flex flex-wrap gap-3">
                    @foreach (var color in Model.Product.Colors)
                    {
                        <span class="rounded-full border border-slate-200 px-4 py-2 text-sm text-slate-600">@color</span>
                    }
                </div>
            </div>

            <div class="grid gap-3 sm:grid-cols-2">
                <button type="button" class="site-button-primary justify-center">Thêm vào giỏ hàng</button>
                <button type="button" class="inline-flex items-center justify-center rounded-xl border border-slate-900 px-4 py-3 text-sm font-semibold text-slate-900 transition hover:border-indigo-600 hover:text-indigo-600">Mua ngay</button>
            </div>

            <div class="rounded-2xl bg-slate-50 p-5">
                <h3 class="text-lg font-bold text-slate-900">Thông tin chi tiết</h3>
                <ul class="mt-4 space-y-3 text-sm leading-6 text-slate-600">
                    @foreach (var feature in Model.FeatureHighlights)
                    {
                        <li class="flex gap-3">
                            <span class="mt-1 h-2 w-2 rounded-full bg-indigo-500"></span>
                            <span>@feature</span>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </div>

    <div class="space-y-5">
        <div>
            <h3 class="text-2xl font-bold text-slate-900">Sản phẩm liên quan</h3>
            <p class="mt-2 text-sm text-slate-500">Gợi ý cùng nhóm để hoàn thiện luồng khám phá sản phẩm.</p>
        </div>

        <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
            @foreach (var product in Model.RelatedProducts)
            {
                <article class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
                    <img src="@product.ImageUrl" alt="@product.Name" class="h-64 w-full object-cover" />
                    <div class="space-y-3 p-5">
                        <div>
                            <p class="text-sm text-slate-500">@product.Gender • @product.Category</p>
                            <h4 class="mt-2 text-xl font-bold text-slate-900">@product.Name</h4>
                        </div>
                        <div class="flex items-center justify-between gap-4">
                            <span class="text-lg font-bold text-slate-900">@product.Price.ToString("N0")đ</span>
                            <a asp-controller="Products" asp-action="Detail" asp-route-id="@product.Id" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700">Xem sản phẩm</a>
                        </div>
                    </div>
                </article>
            }
        </div>
    </div>
</section>
