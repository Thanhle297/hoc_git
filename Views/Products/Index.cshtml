@model ProductListPageViewModel
@{
    ViewData["Title"] = Model.Title;
    var fallbackImageUrl = Url.Content("~/images/product-placeholder.svg");
    var sliderMin = Convert.ToInt32(Model.MinPrice);
    var sliderMax = Convert.ToInt32(Model.MaxPrice);
    var selectedMinPrice = Convert.ToInt32(Model.AppliedMinPrice ?? Model.MinPrice);
    var selectedMaxPrice = Convert.ToInt32(Model.AppliedMaxPrice ?? Model.MaxPrice);

    string BuildIndexUrl(string sort, int page)
    {
        var query = new List<KeyValuePair<string, string?>>
        {
            new("sort", sort),
            new("page", page.ToString())
        };

        query.AddRange(Model.SelectedGenders.Select(gender => new KeyValuePair<string, string?>("genders", gender)));
        query.AddRange(Model.SelectedCategories.Select(category => new KeyValuePair<string, string?>("categories", category)));
        query.AddRange(Model.SelectedSizes.Select(size => new KeyValuePair<string, string?>("sizes", size)));
        query.AddRange(Model.SelectedColors.Select(color => new KeyValuePair<string, string?>("colors", color)));

        if (Model.AppliedMinPrice.HasValue)
        {
            query.Add(new KeyValuePair<string, string?>("minPrice", Model.AppliedMinPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)));
        }

        if (Model.AppliedMaxPrice.HasValue)
        {
            query.Add(new KeyValuePair<string, string?>("maxPrice", Model.AppliedMaxPrice.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)));
        }

        return QueryString.Create(query).ToString();
    }
}

<section class="space-y-8">
    <div class="overflow-hidden rounded-[2rem] bg-gradient-to-r from-slate-950 via-indigo-900 to-purple-800 px-6 py-8 text-white sm:px-8 lg:px-10">
        <div class="max-w-3xl">
            <span class="inline-flex rounded-full bg-white/15 px-4 py-2 text-xs font-semibold uppercase tracking-[0.25em] text-indigo-100">Storefront Demo</span>
            <h2 class="mt-4 text-3xl font-bold sm:text-4xl">@Model.Title</h2>
            <p class="mt-3 text-sm leading-7 text-indigo-100 sm:text-base">@Model.Description</p>
        </div>
    </div>

    <div class="grid gap-8 xl:grid-cols-[300px_minmax(0,1fr)]">
        <aside class="rounded-[2rem] border border-slate-200 bg-slate-50 p-6 xl:sticky xl:top-28 xl:self-start">
            <form asp-controller="Products" asp-action="Index" method="get" class="space-y-5">
                <input type="hidden" name="sort" value="@Model.SelectedSort" />
                <div>
                    <h3 class="text-lg font-bold text-slate-900">Bộ lọc sản phẩm</h3>
                    <p class="mt-2 text-sm text-slate-500">Bộ lọc đang hoạt động qua query string để tiện kiểm thử và demo.</p>
                </div>

                <div class="space-y-3">
                    <p class="text-sm font-semibold text-slate-900">Giới tính</p>
                    @foreach (var gender in Model.Genders)
                    {
                        var isSelected = Model.SelectedGenders.Contains(gender, StringComparer.OrdinalIgnoreCase);
                        <label class="flex items-center gap-3 rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm text-slate-600">
                            <input type="checkbox" name="genders" value="@gender" checked="@isSelected" class="rounded border-slate-300 text-indigo-600 focus:ring-indigo-500" />
                            <span>@gender</span>
                        </label>
                    }
                </div>

                <div class="space-y-3">
                    <p class="text-sm font-semibold text-slate-900">Danh mục</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var category in Model.Categories)
                        {
                            var isSelected = Model.SelectedCategories.Contains(category, StringComparer.OrdinalIgnoreCase);
                            <label class="cursor-pointer">
                                <input type="checkbox" name="categories" value="@category" checked="@isSelected" class="sr-only" />
                                <span class="rounded-full border px-4 py-2 text-sm @(isSelected ? "border-indigo-600 bg-indigo-600 text-white" : "border-slate-200 bg-white text-slate-600")">@category</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="space-y-3">
                    <p class="text-sm font-semibold text-slate-900">Size</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var size in Model.Sizes)
                        {
                            var isSelected = Model.SelectedSizes.Contains(size, StringComparer.OrdinalIgnoreCase);
                            <label class="cursor-pointer">
                                <input type="checkbox" name="sizes" value="@size" checked="@isSelected" class="sr-only" />
                                <span class="inline-flex h-10 min-w-10 items-center justify-center rounded-xl border px-3 text-sm font-medium @(isSelected ? "border-indigo-600 bg-indigo-600 text-white" : "border-slate-200 bg-white text-slate-700")">@size</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="space-y-3">
                    <p class="text-sm font-semibold text-slate-900">Màu sắc</p>
                    <div class="flex flex-wrap gap-2">
                        @foreach (var color in Model.Colors)
                        {
                            var isSelected = Model.SelectedColors.Contains(color, StringComparer.OrdinalIgnoreCase);
                            <label class="cursor-pointer">
                                <input type="checkbox" name="colors" value="@color" checked="@isSelected" class="sr-only" />
                                <span class="rounded-full px-4 py-2 text-sm ring-1 @(isSelected ? "bg-slate-900 text-white ring-slate-900" : "bg-white text-slate-600 ring-slate-200")">@color</span>
                            </label>
                        }
                    </div>
                </div>

                <div class="rounded-2xl border border-indigo-100 bg-indigo-50 p-4 text-sm text-slate-600">
                    <p class="font-semibold text-slate-900">Khoảng giá</p>
                    <p class="mt-2">Khả dụng: @Model.MinPrice.ToString("N0")đ - @Model.MaxPrice.ToString("N0")đ</p>

                    <div class="mt-4 space-y-4" data-price-slider data-min-bound="@sliderMin" data-max-bound="@sliderMax">
                        <div class="grid grid-cols-2 gap-3">
                            <div class="rounded-2xl bg-white px-4 py-3 shadow-sm ring-1 ring-indigo-100">
                                <p class="text-xs font-semibold uppercase tracking-[0.15em] text-slate-500">Từ</p>
                                <p class="mt-2 text-base font-bold text-slate-900" data-price-min-display>@selectedMinPrice.ToString("N0")đ</p>
                            </div>
                            <div class="rounded-2xl bg-white px-4 py-3 shadow-sm ring-1 ring-indigo-100">
                                <p class="text-xs font-semibold uppercase tracking-[0.15em] text-slate-500">Đến</p>
                                <p class="mt-2 text-base font-bold text-slate-900" data-price-max-display>@selectedMaxPrice.ToString("N0")đ</p>
                            </div>
                        </div>

                        <div class="site-price-slider">
                            <div class="site-price-slider__track"></div>
                            <div class="site-price-slider__range" data-price-range></div>
                            <input id="minPrice" name="minPrice" type="range" min="@sliderMin" max="@sliderMax" step="1000" value="@selectedMinPrice" class="site-price-slider__input" data-price-min />
                            <input id="maxPrice" name="maxPrice" type="range" min="@sliderMin" max="@sliderMax" step="1000" value="@selectedMaxPrice" class="site-price-slider__input" data-price-max />
                        </div>

                        <div class="flex items-center justify-between text-xs font-medium text-slate-500">
                            <span>@sliderMin.ToString("N0")đ</span>
                            <span>@sliderMax.ToString("N0")đ</span>
                        </div>
                    </div>
                </div>

                <div class="flex flex-wrap gap-3">
                    <button type="submit" class="site-button-primary justify-center">Áp dụng bộ lọc</button>
                    <a asp-controller="Products" asp-action="Index" class="inline-flex items-center justify-center rounded-xl border border-slate-200 bg-white px-4 py-3 text-sm font-semibold text-slate-700 transition hover:border-indigo-300 hover:text-indigo-600">Xóa lọc</a>
                </div>
            </form>
        </aside>

        <div class="space-y-6">
            <div class="flex flex-col gap-4 rounded-[2rem] border border-slate-200 bg-white p-5 sm:flex-row sm:items-center sm:justify-between">
                <div>
                    <p class="text-sm text-slate-500">Hiển thị @Model.Products.Count/@Model.TotalResults sản phẩm trên trang @Model.CurrentPage.</p>
                </div>

                <div class="flex flex-wrap items-center gap-3 text-sm">
                    <span class="font-semibold text-slate-700">Sắp xếp</span>
                    @foreach (var sortOption in new[] { "Mới nhất", "Bán chạy", "Giá tăng dần", "Giá giảm dần" })
                    {
                        var isSelected = string.Equals(Model.SelectedSort, sortOption, StringComparison.OrdinalIgnoreCase);
                        <a href="@($"/Products{BuildIndexUrl(sortOption, 1)}")"
                           class="rounded-full px-4 py-2 @(isSelected ? "bg-indigo-600 text-white" : "border border-slate-200 text-slate-600 hover:border-indigo-200 hover:text-indigo-600")">
                            @sortOption
                        </a>
                    }
                </div>
            </div>

            <div class="grid gap-6 md:grid-cols-2 2xl:grid-cols-3">
                @foreach (var product in Model.Products)
                {
                    <article class="flex h-full flex-col overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm transition hover:-translate-y-1 hover:shadow-xl">
                        <div class="relative overflow-hidden bg-slate-100">
                            <img src="@product.ImageUrl" alt="@product.Name" onerror="this.onerror=null;this.src='@fallbackImageUrl';" class="h-72 w-full object-cover object-center" loading="lazy" />
                            <div class="absolute left-4 top-4 flex gap-2">
                                @if (product.IsNew)
                                {
                                    <span class="rounded-full bg-white/90 px-3 py-1 text-xs font-semibold text-indigo-600">Mới</span>
                                }
                                @if (product.IsBestSeller)
                                {
                                    <span class="rounded-full bg-rose-500 px-3 py-1 text-xs font-semibold text-white">Bán chạy</span>
                                }
                            </div>
                        </div>

                        <div class="flex h-full flex-col space-y-4 p-5">
                            <div class="min-h-[9rem]">
                                <p class="text-sm text-slate-500">@product.Gender • @product.Category</p>
                                <h3 class="mt-2 text-xl font-bold text-slate-900">@product.Name</h3>
                                <p class="mt-2 text-sm leading-6 text-slate-600">@product.ShortDescription</p>
                            </div>

                            <div class="flex items-center gap-3 text-sm text-amber-500">
                                <span>@product.Rating.ToString("0.0")/5</span>
                                <span class="text-slate-400">(@product.ReviewCount đánh giá)</span>
                            </div>

                            <div class="mt-auto flex items-end justify-between gap-4">
                                <div>
                                    <p class="text-2xl font-bold text-slate-900">@product.Price.ToString("N0")đ</p>
                                    @if (product.OriginalPrice.HasValue)
                                    {
                                        <p class="text-sm text-slate-400 line-through">@product.OriginalPrice.Value.ToString("N0")đ</p>
                                    }
                                </div>

                                <a asp-controller="Products" asp-action="Detail" asp-route-id="@product.Id" class="inline-flex items-center rounded-full bg-slate-900 px-4 py-2 text-sm font-semibold text-white transition hover:bg-indigo-600">
                                    Xem chi tiết
                                </a>
                            </div>
                        </div>
                    </article>
                }
            </div>

            <div class="flex flex-wrap items-center justify-center gap-3 rounded-[2rem] border border-slate-200 bg-white p-4">
                @for (var pageNumber = 1; pageNumber <= Model.TotalPages; pageNumber++)
                {
                    var isActive = pageNumber == Model.CurrentPage;
                    <a href="@($"/Products{BuildIndexUrl(Model.SelectedSort, pageNumber)}")"
                       class="inline-flex h-11 w-11 items-center justify-center rounded-full @(isActive ? "bg-indigo-600 text-white" : "border border-slate-200 text-slate-600")">@pageNumber</a>
                }
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const slider = document.querySelector('[data-price-slider]');

            if (!slider) {
                return;
            }

            const minInput = slider.querySelector('[data-price-min]');
            const maxInput = slider.querySelector('[data-price-max]');
            const minDisplay = slider.querySelector('[data-price-min-display]');
            const maxDisplay = slider.querySelector('[data-price-max-display]');
            const range = slider.querySelector('[data-price-range]');
            const minBound = Number(slider.dataset.minBound);
            const maxBound = Number(slider.dataset.maxBound);
            const minGap = 1000;

            if (!minInput || !maxInput || !minDisplay || !maxDisplay || !range) {
                return;
            }

            const formatCurrency = value => `${Number(value).toLocaleString('vi-VN')}đ`;

            const updateSlider = source => {
                let minValue = Number(minInput.value);
                let maxValue = Number(maxInput.value);

                if (maxValue - minValue < minGap) {
                    if (source === minInput) {
                        minValue = Math.min(maxValue - minGap, maxBound - minGap);
                        minInput.value = String(Math.max(minValue, minBound));
                    } else {
                        maxValue = Math.max(minValue + minGap, minBound + minGap);
                        maxInput.value = String(Math.min(maxValue, maxBound));
                    }
                }

                minValue = Number(minInput.value);
                maxValue = Number(maxInput.value);

                const left = ((minValue - minBound) / (maxBound - minBound)) * 100;
                const right = ((maxValue - minBound) / (maxBound - minBound)) * 100;

                range.style.left = `${left}%`;
                range.style.width = `${right - left}%`;
                minDisplay.textContent = formatCurrency(minValue);
                maxDisplay.textContent = formatCurrency(maxValue);
            };

            minInput.addEventListener('input', function () {
                updateSlider(minInput);
            });

            maxInput.addEventListener('input', function () {
                updateSlider(maxInput);
            });

            updateSlider();
        });
    </script>
}
