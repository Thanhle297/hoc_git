@model ProductSearchPageViewModel
@{
    ViewData["Title"] = "Tìm kiếm sản phẩm";
}

<section class="space-y-8">
    <div class="rounded-[2rem] border border-slate-200 bg-white p-6 shadow-sm sm:p-8">
        <div class="max-w-3xl">
            <h2 class="text-3xl font-bold text-slate-900">Tìm kiếm sản phẩm</h2>
            <p class="mt-3 text-sm leading-7 text-slate-600">Nhập tên sản phẩm, danh mục hoặc nhóm khách hàng để xem kết quả phù hợp.</p>
        </div>

        <form asp-controller="Products" asp-action="Search" method="get" class="mt-6 flex flex-col gap-3 sm:flex-row">
            <input name="q" value="@Model.Query" type="text" placeholder="Ví dụ: sneaker, áo khoác, nữ..." class="site-input flex-1" />
            <button type="submit" class="site-button-primary justify-center sm:px-6">Tìm kiếm</button>
        </form>
    </div>

    @if (string.IsNullOrWhiteSpace(Model.Query))
    {
        <div class="rounded-[2rem] border border-dashed border-slate-300 bg-slate-50 px-6 py-12 text-center">
            <h3 class="text-xl font-bold text-slate-900">Bắt đầu bằng một từ khóa</h3>
            <p class="mt-3 text-sm text-slate-500">Bạn có thể thử các cụm như “giày”, “áo”, “nam”, “nữ” để xem luồng kết quả tìm kiếm.</p>
        </div>
    }
    else if (Model.Results.Count == 0)
    {
        <div class="rounded-[2rem] border border-dashed border-amber-300 bg-amber-50 px-6 py-12 text-center">
            <h3 class="text-xl font-bold text-slate-900">Không tìm thấy kết quả cho “@Model.Query”</h3>
            <p class="mt-3 text-sm text-slate-500">Hãy thử một từ khóa ngắn hơn hoặc chuyển sang danh mục sản phẩm để tiếp tục khám phá.</p>
            <a asp-controller="Products" asp-action="Index" class="mt-5 inline-flex rounded-full bg-slate-900 px-5 py-3 text-sm font-semibold text-white transition hover:bg-indigo-600">Xem tất cả sản phẩm</a>
        </div>
    }
    else
    {
        <div class="space-y-5">
            <div>
                <h3 class="text-2xl font-bold text-slate-900">Kết quả tìm kiếm</h3>
                <p class="mt-2 text-sm text-slate-500">Tìm thấy @Model.Results.Count sản phẩm phù hợp với từ khóa “@Model.Query”.</p>
            </div>

            <div class="grid gap-6 md:grid-cols-2 xl:grid-cols-3">
                @foreach (var product in Model.Results)
                {
                    <article class="overflow-hidden rounded-[2rem] border border-slate-200 bg-white shadow-sm">
                        <img src="@product.ImageUrl" alt="@product.Name" class="h-64 w-full object-cover" />
                        <div class="space-y-3 p-5">
                            <div>
                                <p class="text-sm text-slate-500">@product.Gender • @product.Category</p>
                                <h4 class="mt-2 text-xl font-bold text-slate-900">@product.Name</h4>
                                <p class="mt-2 text-sm leading-6 text-slate-600">@product.ShortDescription</p>
                            </div>
                            <div class="flex items-center justify-between gap-4">
                                <span class="text-lg font-bold text-slate-900">@product.Price.ToString("N0")đ</span>
                                <a asp-controller="Products" asp-action="Detail" asp-route-id="@product.Id" class="text-sm font-semibold text-indigo-600 hover:text-indigo-700">Xem chi tiết</a>
                            </div>
                        </div>
                    </article>
                }
            </div>
        </div>
    }
</section>
